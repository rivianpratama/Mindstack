DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
PORT=8787

# Optional. deepseek-v4-flash is a hybrid reasoning model and its reasoning tokens are
# billed against max_tokens, so leaving thinking on can consume the whole budget and return
# an empty report; "none" (the default) keeps all of it for the report, "default" omits the
# parameter and lets the model choose. Avoid "low" on flash — it behaved inconsistently.
DEEPSEEK_REASONING_EFFORT=none
