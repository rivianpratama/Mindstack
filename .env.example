# Provider failover. OpenRouter is the PRIMARY (its free deepseek-v4-flash slug); DeepSeek
# direct is the FALLBACK. Both are optional and additive: set one key for a single provider,
# both to fail over, neither for the honest-null (no-model) path. On a runtime failure that
# happens BEFORE the first byte reaches the reader (rate limit / 5xx / network / auth), the
# app switches OpenRouter -> DeepSeek and retries once; once anything has streamed it does not.
OPENROUTER_API_KEY=
# Optional overrides (these are the defaults):
# OPENROUTER_MODEL=deepseek/deepseek-v4-flash:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional OpenRouter free-tier attribution headers:
# OPENROUTER_APP_TITLE=Mindstack
# OPENROUTER_APP_URL=

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
PORT=8787

# Optional. deepseek-v4-flash is a hybrid reasoning model; its reasoning tokens are billed
# against max_tokens. DeepSeek documents exactly three effort levels (low/high/max) and its
# API rejects values outside its enum (400), so the app normalizes aliases and typos itself.
# Note: effort is a bias, not a hard cap — a hard prompt can exhaust the budget even on low.
#   none    -> thinking OFF, fastest; all of max_tokens goes to the report
#   low     -> shortest thinking (the app default when unset; alias: minimal)
#   high    -> deeper thinking (aliases: medium, xhigh)
#   max     -> deepest, slowest (can think for minutes on a big prompt)
#   default -> omit the parameter; DeepSeek's server-side default applies (currently high)
# NOTE: tsx watch does NOT reload .env — fully restart the server after changing this.
DEEPSEEK_REASONING_EFFORT=none
